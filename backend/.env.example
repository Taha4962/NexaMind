# ══════════════════════════════════════════════════════════════
# NexaMind Backend — Environment Variables
# ══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ══════════════════════════════════════════════════════════════

# ── MongoDB Atlas Connection ──
# Connection string from MongoDB Atlas dashboard
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>
MONGO_URL=mongodb+srv://your-username:your-password@cluster.mongodb.net/nexamind

# ── Server Configuration ──
# Port for the FastAPI backend server
PYTHON_BACKEND_PORT=8000

# ── CORS ──
# Frontend URL allowed to make API requests (comma-separated for multiple origins)
CLIENT_URL=http://localhost:3000

# ── Authentication ──
# JWT signing secret — MUST match the frontend JWT_ACCESS_SECRET
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_ACCESS_SECRET=minimum-32-character-random-string-change-this

# ── Google Gemini AI ──
# API key from Google AI Studio: https://aistudio.google.com/apikey
# Used for Gemini 2.5 Flash (primary LLM) and text-embedding-004
GEMINI_API_KEY=your-gemini-api-key-from-google-ai-studio

# ── Groq (Fallback LLM) ──
# API key from Groq Console: https://console.groq.com
# Used for Llama 3.3 70B and Llama 3.1 8B fallback models
GROQ_API_KEY=your-groq-api-key-from-console

# ── Cloudinary (File Storage) ──
# Credentials from Cloudinary dashboard: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── ChromaDB (Vector Store) ──
# Local directory for ChromaDB persistent storage
# This path is relative to the backend directory
CHROMA_PERSIST_DIR=./chroma_data

# ── Tavily (Web Search) ──
# API key from Tavily: https://tavily.com
# Used by the web search agent for real-time web queries
TAVILY_API_KEY=your-tavily-api-key

# ── Allowed Origins ──
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000
